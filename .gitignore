# ------------------------------------------------------------
# Files that Git should NOT track. Adapt to your project.
# Syntax: "*" = any characters, "!" = exception, "#" = comment
# ------------------------------------------------------------

# Data and outputs: not committed, but the README of each folder is kept
data/*
!data/README.md
outputs/*
!outputs/README.md
# To commit one specific small file, add an exception, e.g.:
# !data/small_file.csv

# Secrets and credentials: NEVER commit these
.env
.Renviron

# R: session files and local package library
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/

# Python: caches and virtual environments
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Operating system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
